# ============================================================
# ResQLink Environment Configuration
# Copy this file to .env.local and fill in values as needed.
# The application runs fully WITHOUT any of these using the
# deterministic Demo AI engine and local SQLite database.
# ============================================================

# ------------------------------------------------------------
# AUTH_SECRET
# PURPOSE:  Secret used to sign session JWTs (HS256).
# REQUIRED: Recommended for production. OPTIONAL in dev.
# HOW:      Generate with `openssl rand -base64 32`.
# FALLBACK: A built-in development secret is used if unset
#           (NOT safe for production).
# ------------------------------------------------------------
AUTH_SECRET=

# ------------------------------------------------------------
# RESQLINK_DB_PATH
# PURPOSE:  Filesystem path for the SQLite database file.
# REQUIRED: OPTIONAL
# FALLBACK: ./data/resqlink.db
# ------------------------------------------------------------
RESQLINK_DB_PATH=

# ------------------------------------------------------------
# AI PROVIDER (OPTIONAL — deterministic demo engine used if absent)
# ------------------------------------------------------------

# AI_PROVIDER
# PURPOSE:  Selects the AI backend. One of: "demo" | "openai".
# REQUIRED: OPTIONAL
# FALLBACK: "demo" (deterministic, offline, no key required).
AI_PROVIDER=demo

# OPENAI_API_KEY
# PURPOSE:  API key for the OpenAI-compatible LLM provider.
# REQUIRED: OPTIONAL (only if AI_PROVIDER=openai)
# HOW:      https://platform.openai.com/api-keys
# FALLBACK: Falls back to deterministic demo engine on error/absence.
OPENAI_API_KEY=

# OPENAI_BASE_URL
# PURPOSE:  Override base URL for OpenAI-compatible endpoints.
# REQUIRED: OPTIONAL
# FALLBACK: https://api.openai.com/v1
OPENAI_BASE_URL=

# OPENAI_MODEL
# PURPOSE:  Model name for LLM calls.
# REQUIRED: OPTIONAL
# FALLBACK: gpt-4o-mini
OPENAI_MODEL=

# ------------------------------------------------------------
# MAP TILES (OPTIONAL)
# PURPOSE:  The map uses free OpenStreetMap raster tiles by default.
#           Provide a custom tile URL template only if desired.
# REQUIRED: OPTIONAL
# FALLBACK: https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# ------------------------------------------------------------
NEXT_PUBLIC_MAP_TILE_URL=
